{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message sent in the global chat.",
      "type": "object",
      "properties": {
        "campusId": { "type": "string" },
        "text": { "type": "string" },
        "sender": { "type": "string" },
        "uid": { "type": "string" },
        "time": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["campusId", "text", "sender", "uid", "time", "timestamp"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "The progress of a user in the app.",
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "completedChapters": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["score", "completedChapters"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "A recipe created by a user.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "ingredients": { "type": "string" },
        "instructions": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["title", "ingredients", "instructions", "authorUid", "authorName", "timestamp"]
    }
  },
  "firestore": {
    "/artifacts/{appId}/public/data/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Global chat messages."
    },
    "/artifacts/{appId}/users/{userId}/user_data/progress": {
      "schema": "UserProgress",
      "description": "User specific progress data."
    },
    "/artifacts/{appId}/public/data/recipes/{recipeId}": {
      "schema": "Recipe",
      "description": "Shared recipes."
    }
  }
}
