{
  "entities": {
    "UserProgress": {
      "title": "User Progress",
      "description": "Tracks a user's score and completed chapters.",
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "description": "The total score/flame points earned by the user."
        },
        "completedChapters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of chapter IDs the user has completed."
        }
      },
      "required": ["score", "completedChapters"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message sent in the global chat.",
      "type": "object",
      "properties": {
        "campusId": { "type": "string" },
        "text": { "type": "string" },
        "sender": { "type": "string" },
        "uid": { "type": "string" },
        "time": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["campusId", "text", "sender", "uid", "time", "timestamp"]
    }
  },
  "firestore": {
    "/artifacts/hospi-scholar-app/users/{userId}/user_data/progress": {
      "schema": "UserProgress",
      "description": "User-specific progress data."
    },
    "/artifacts/hospi-scholar-app/public/data/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Global chat messages."
    }
  }
}
