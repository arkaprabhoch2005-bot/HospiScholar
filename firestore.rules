rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email == "arkaprabhoch.2005@gmail.com" && request.auth.token.email_verified == true) ||
         (request.auth.token.email == "admin@hospischolar.com"));
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['score', 'completedChapters']) &&
             data.score is number &&
             data.completedChapters is list;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['campusId', 'text', 'sender', 'uid', 'time', 'timestamp']) &&
             data.campusId is string && data.campusId.size() <= 50 &&
             data.text is string && data.text.size() <= 500 &&
             data.sender is string && data.sender.size() <= 100 &&
             data.uid == request.auth.uid &&
             data.time is string &&
             data.timestamp is number;
    }

    function isValidGuestVisit(data) {
      return data.keys().hasAll(['name', 'email', 'photoURL', 'method', 'status', 'userAgent', 'timestamp', 'time', 'date', 'uid']) &&
             data.name is string && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 150 &&
             data.photoURL is string && data.photoURL.size() <= 1000 &&
             data.method is string && data.method in ['google', 'guest', 'admin'] &&
             data.status is string && data.status in ['signed_in', 'attempted', 'failed', 'guest_access'] &&
             data.userAgent is string && data.userAgent.size() <= 500 &&
             data.timestamp is number &&
             data.time is string && data.time.size() <= 50 &&
             data.date is string && data.date.size() <= 50 &&
             data.uid is string && data.uid.size() <= 128;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /artifacts/hospi-scholar-app {
      
      match /users/{userId}/user_data/progress {
        allow read, write: if isOwner(userId) && (request.method == 'read' || isValidProgress(request.resource.data));
      }

      match /public/data/chat_messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidChatMessage(request.resource.data);
        allow update, delete: if isAdmin();
      }

      match /public/data/guest_visits/{visitId} {
        // Allow visitors and guests to record attendance or entry attempts
        allow create: if isValidGuestVisit(request.resource.data);
        // Allow reading guest logs (for visitor counter and tracking dashboard)
        allow read: if true;
        // Allow updates if authenticated
        allow update: if isAuthenticated();
        // Allow deletion only by admin
        allow delete: if isAdmin();
      }
      
      // Default deny
      match /{allPaths=**} {
        allow read, write: if false;
      }
    }
  }
}
