rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /artifacts/hospi-scholar-app/users/{userId}/user_data/progress
    // Document ID: progress
    // Fields:
    //   - score: number (required) - Total points
    //   - completedChapters: list (required) - Array of strings
    //
    // Collection: /artifacts/hospi-scholar-app/public/data/chat_messages
    // Document ID: auto-generated
    // Fields:
    //   - campusId: string (required) - Campus filter
    //   - text: string (required, max 500) - Message content
    //   - sender: string (required) - Display name
    //   - uid: string (required) - User ID
    //   - time: string (required) - Formatted time
    //   - timestamp: number (required) - Server timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/artifacts/hospi-scholar-app/users/$(request.auth.uid)/user_data/profile).data.role == 'admin' ||
          (request.auth.token.email == "arkaprabhoch.2005@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['score', 'completedChapters']) &&
             data.score is number &&
             data.completedChapters is list;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['campusId', 'text', 'sender', 'uid', 'time', 'timestamp']) &&
             data.campusId is string &&
             data.text is string && data.text.size() <= 500 &&
             data.sender is string &&
             data.uid == request.auth.uid &&
             data.time is string &&
             data.timestamp is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /artifacts/hospi-scholar-app {
      
      match /users/{userId}/user_data/progress {
        allow read, write: if isOwner(userId) && (request.method == 'read' || isValidProgress(request.resource.data));
      }

      match /public/data/chat_messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidChatMessage(request.resource.data);
        allow update, delete: if isAdmin();
      }
      
      // Default deny
      match /{allPaths=**} {
        allow read, write: if isAdmin();
      }
    }
  }
}
